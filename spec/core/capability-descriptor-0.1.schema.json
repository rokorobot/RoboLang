{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:robolang:core:capability-descriptor:0.1",
  "title": "RoboLang Core capability descriptor, version 0.1 (draft)",
  "description": "spec/core-v0.1.md section 6. A capability is declared, not proven. A descriptor past 'valid_until' is treated as absent. Each capability kind appears at most once, in 'capabilities' or in 'unsupported' (checked outside the schema).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "robot",
    "capabilities",
    "unsupported",
    "issued_at",
    "valid_until",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "robolang.core.capability-descriptor"
    },
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "robot": {
      "$ref": "#/$defs/identifier"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability_kind"
      },
      "uniqueItems": true
    },
    "issued_at": {
      "$ref": "#/$defs/time"
    },
    "valid_until": {
      "$ref": "#/$defs/time"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "identifier": {
      "description": "Opaque identifier (core-v0.1.md 2.4).",
      "type": "string",
      "pattern": "^rl:[a-z][a-z_]*:[A-Za-z0-9][A-Za-z0-9._:@#-]{0,127}$"
    },
    "key_ref": {
      "description": "A key of a participant: an identifier with a '#' fragment.",
      "type": "string",
      "pattern": "^rl:[a-z][a-z_]*:[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}#[A-Za-z0-9._-]{1,64}$"
    },
    "time": {
      "description": "UTC time, RFC 3339, at most millisecond precision, 'Z' suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "positive_decimal": {
      "type": "string",
      "pattern": "^(0*[1-9][0-9]*(\\.[0-9]+)?|0+\\.[0-9]*[1-9][0-9]*)$"
    },
    "mass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/positive_decimal"
        },
        "unit": {
          "const": "kg"
        }
      }
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/positive_decimal"
        },
        "unit": {
          "const": "m/s"
        }
      }
    },
    "signature": {
      "description": "core-v0.1.md section 7. Covers the enclosing object without this field, in JCS form.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "key",
        "value"
      ],
      "properties": {
        "alg": {
          "enum": [
            "ed25519",
            "sim-hmac-sha256"
          ]
        },
        "key": {
          "$ref": "#/$defs/key_ref"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,512}$"
        }
      }
    },
    "capability_kind": {
      "enum": [
        "transport_payload",
        "dock_at",
        "grasp",
        "inspect"
      ]
    },
    "capability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_mass",
            "max_speed",
            "operating_area"
          ],
          "properties": {
            "kind": {
              "const": "transport_payload"
            },
            "max_mass": {
              "$ref": "#/$defs/mass"
            },
            "max_speed": {
              "$ref": "#/$defs/speed"
            },
            "operating_area": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "places"
          ],
          "properties": {
            "kind": {
              "const": "dock_at"
            },
            "places": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_mass",
            "reach"
          ],
          "properties": {
            "kind": {
              "const": "grasp"
            },
            "max_mass": {
              "$ref": "#/$defs/mass"
            },
            "reach": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sensor",
            "properties",
            "places"
          ],
          "properties": {
            "kind": {
              "const": "inspect"
            },
            "sensor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "properties": {
              "type": "array",
              "items": {
                "enum": [
                  "located_in",
                  "carried_by"
                ]
              },
              "minItems": 1
            },
            "places": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
