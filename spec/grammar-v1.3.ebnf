(* RoboLang v1.3 grammar, implemented in src/robolang/parser.py.
   RoboLang 1.2 plus a goal block, outcome atoms and the sensor parameter type.
   Differences from grammar-v1.2.ebnf are marked [1.3].
   Notation: ISO-style EBNF.  { x } = zero or more, [ x ] = optional, | = choice.
   Normative text, diagnostics and static rules: spec/robolang-v1.3.md *)

(* ---------- syntactic grammar ---------- *)

program       = version_decl , task , { task } ;                (* [1.3] marker required *)

version_decl  = "robolang" , NUMBER , ";" ;                (* [1.3] NUMBER written exactly 1.3 *)

task          = "task" , IDENT , "(" , [ param , { "," , param } ] , ")" ,
                "{" , { annotation } , [ pre ] , goal , plan , "}" ;       (* [1.3] goal *)

param         = type , IDENT ;
type          = "robot" | "object" | "location" | "region" | "sensor" ;    (* [1.3] sensor *)

annotation    = "@safety" , safety_rule , ";"
              | "@verify" , verify_rule , ";" ;                            (* [1.3] *)
safety_rule   = "max_speed" , NUMBER , [ SPEED_UNIT ] ;   (* omitting the unit is deprecated: W401 *)
verify_rule   = "min_confidence" , NUMBER                                  (* [1.3] 0 to 1: E312 *)
              | "max_age" , duration ;                                     (* [1.3] *)
(* [1.3] Each verify key at most once per task: E311. "@verify" is lexed only in a 1.3 file. *)

pre           = "pre" , "{" , { condition , ";" } , "}" ;
goal          = "goal" , "{" , condition , ";" , { condition , ";" } , "}" ;   (* [1.3] at least one *)
plan          = "plan" , "{" , statement , { statement } , "}" ;

condition     = operand , [ "and" , operand , { "and" , operand }
                          | "or"  , operand , { "or"  , operand } ] ;
operand       = "not" , operand
              | "(" , condition , ")"
              | atom ;
(* "and" and "or" are never mixed at one level without parentheses: E214.
   Depth at most 8 (robolang-v1.2.md section 3.3): E215. *)

atom          = "robot_ready"   , IDENT
              | "region_clear"  , IDENT
              | "object_exists" , IDENT
              | "sensor_ok"     , sensor_ref                               (* [1.3] *)
              | "object_at"     , IDENT , IDENT                            (* [1.3] object, location *)
              | "robot_at"      , IDENT , IDENT                            (* [1.3] robot, location *)
              | "holding"       , IDENT , IDENT ;                          (* [1.3] robot, object *)

sensor_ref    = IDENT | STRING ;
(* [1.3] The name must be a "sensor" parameter. A STRING is read and then rejected by the
   validator (E310), so that the message can tell the author to declare a sensor parameter. *)

statement     = ( move | grasp | place | inspect | wait | communicate ) , ";" ;

move          = "move" , IDENT , "to" , IDENT ;
grasp         = "grasp" , IDENT , IDENT ;
place         = "place" , IDENT , IDENT , "at" , IDENT ;
inspect       = "inspect" , IDENT , IDENT , "using" , sensor_ref ;         (* [1.3] *)
wait          = "wait" , "for" , duration
              | "wait" , "until" , condition , "timeout" , duration ;
communicate   = "communicate" , IDENT , "to" , STRING , "with" , STRING ;

duration      = NUMBER , DURATION_UNIT ;

(* ---------- lexical grammar ---------- *)

IDENT         = letter , { letter | digit | "_" } ;       (* must not be a reserved word *)
NUMBER        = digit , { digit } , [ "." , digit , { digit } ] ;
STRING        = '"' , { string_char } , '"' ;
SPEED_UNIT    = "m/s" | "rad/s" ;
DURATION_UNIT = "ms" | "s" | "min" ;

letter        = "A" .. "Z" | "a" .. "z" ;
digit         = "0" .. "9" ;
string_char   = ? any character except '"', '\' and line terminators ?
              | escape ;
escape        = '\' , ( '"' | '\' | "n" | "t" ) ;

comment       = "//" , { ? any character except line terminators ? } ;
whitespace    = " " | "\t" | "\r" | "\n" ;

(* A file without a marker, or with "robolang 1.1;", is RoboLang 1.1 (grammar.ebnf); with
   "robolang 1.2;" it is RoboLang 1.2 (grammar-v1.2.ebnf).

   Reserved words in a 1.3 file (never valid as IDENT):
     robolang task pre plan robot object location region
     move grasp place inspect wait communicate
     to at using with for until timeout
     robot_ready region_clear object_exists sensor_ok
     and or not
     goal sensor object_at robot_at holding                [1.3]
   Reserved for constructs documented in v1 but not part of v1.1 to v1.3:
     with_approach in_region no_go_region require_guard message_received scalar duration

   Not reserved (recognized only in their grammatical position):
     max_speed, min_confidence, max_age, and the unit words ms s min *)
