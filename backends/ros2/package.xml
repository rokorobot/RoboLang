<?xml version="1.0"?>
<package format="3">
  <name>robolang_ros2</name>
  <version>0.1.0</version>
  <description>Simulation-only ROS 2 backend for RoboLang</description>
  <maintainer email="rokorobot@users.noreply.github.com">Robert Konecny</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>robolang</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
