{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.12",
  "language_version": "2.4",
  "tasks": [
    {
      "name": "t",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "dest",
          "type": "location"
        },
        {
          "name": "dock",
          "type": "location"
        }
      ],
      "safety": [],
      "preconditions": [],
      "goal": [
        {
          "kind": "robot_at",
          "robot": "r",
          "location": "dest"
        }
      ],
      "steps": [
        {
          "kind": "wait_until",
          "condition": {
            "kind": "and",
            "conditions": [
              {
                "kind": "compare",
                "left": {
                  "kind": "charge",
                  "robot": "r"
                },
                "op": ">=",
                "right": {
                  "kind": "quantity",
                  "value": "90",
                  "unit": "%"
                }
              },
              {
                "kind": "compare",
                "left": {
                  "kind": "clock",
                  "reading": "time"
                },
                "op": "<",
                "right": {
                  "kind": "time",
                  "value": "23:00:00"
                }
              }
            ]
          },
          "timeout": {
            "value": "120",
            "unit": "min"
          },
          "else": [
            {
              "kind": "fail",
              "reason": "not charged by 23:00"
            }
          ]
        },
        {
          "kind": "move",
          "robot": "r",
          "target": "dest"
        }
      ]
    }
  ]
}
