{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.7",
  "language_version": "1.8",
  "tasks": [
    {
      "name": "open_if_clear",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "door",
          "type": "object"
        },
        {
          "name": "pass_area",
          "type": "region"
        }
      ],
      "safety": [],
