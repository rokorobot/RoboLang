{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.2",
  "language_version": "1.3",
  "tasks": [
    {
      "name": "t",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "box",
          "type": "object"
        },
        {
          "name": "src",
          "type": "location"
        },
        {
          "name": "dst",
          "type": "location"
        },
        {
          "name": "cell",
          "type": "region"
        },
        {
          "name": "cam",
          "type": "sensor"
        }
      ],
      "safety": [],
      "preconditions": [
        {
          "kind": "sensor_ok",
          "sensor": "cam"
        }
      ],
      "goal": [
        {
          "kind": "object_at",
          "object": "box",
          "location": "dst"
        }
      ],
      "steps": [
        {
          "kind": "wait_until",
          "condition": {
            "kind": "sensor_ok",
            "sensor": "cam"
          },
          "timeout": {
            "value": "2",
            "unit": "s"
          }
        },
        {
          "kind": "move",
          "robot": "r",
          "target": "dst"
        }
      ]
    }
  ]
