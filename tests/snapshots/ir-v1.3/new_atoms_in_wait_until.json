              }
            ]
          },
          "timeout": {
            "value": "5",
            "unit": "s"
          }
        },
        {
          "kind": "wait_until",
          "condition": {
            "kind": "robot_at",
            "robot": "r",
            "location": "dst"
          },
          "timeout": {
            "value": "500",
            "unit": "ms"
          }
        }
      ]
    }
  ]
