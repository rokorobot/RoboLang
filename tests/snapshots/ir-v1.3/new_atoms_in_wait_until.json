{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.2",
  "language_version": "1.3",
  "tasks": [
    {
      "name": "t",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "box",
          "type": "object"
        },
        {
          "name": "src",
          "type": "location"
        },
        {
          "name": "dst",
          "type": "location"
        },
        {
          "name": "cell",
          "type": "region"
        },
        {
          "name": "cam",
          "type": "sensor"
        }
      ],
      "safety": [],
      "preconditions": [],
      "goal": [
        {
          "kind": "object_at",
          "object": "box",
          "location": "dst"
        }
      ],
      "steps": [
        {
          "kind": "wait_until",
          "condition": {
            "kind": "or",
            "conditions": [
              {
                "kind": "object_at",
                "object": "box",
                "location": "dst"
              },
              {
                "kind": "holding",
                "robot": "r",
