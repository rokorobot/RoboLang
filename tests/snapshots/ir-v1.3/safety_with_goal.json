{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.2",
  "language_version": "1.3",
  "tasks": [
    {
      "name": "t",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "dst",
          "type": "location"
        }
      ],
      "safety": [
        {
          "kind": "max_speed",
          "limit": {
            "value": "0.5",
            "unit": "m/s"
          }
        }
      ],
      "preconditions": [
        {
          "kind": "robot_ready",
          "robot": "r"
        }
      ],
      "goal": [
        {
          "kind": "robot_at",
          "robot": "r",
          "location": "dst"
        }
      ],
      "steps": [
        {
          "kind": "move",
          "robot": "r",
          "target": "dst"
        }
      ]
    }
  ]
}
