{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.11",
  "language_version": "2.3",
  "tasks": [
    {
      "name": "send_one",
      "parameters": [
        {
          "name": "a",
          "type": "robot"
        },
        {
          "name": "b",
          "type": "robot"
        },
        {
          "name": "dst",
          "type": "location"
        }
      ],
      "safety": [],
      "preconditions": [],
      "goal": [
        {
          "kind": "robot_at",
          "robot": "t",
          "location": "dst"
        }
      ],
      "steps": [
        {
          "kind": "choose",
          "type": "robot",
          "name": "t",
          "source": {
            "kind": "list",
            "candidates": [
              "a",
              "b"
            ]
          },
          "where": {
            "kind": "and",
            "conditions": [
              {
                "kind": "robot_ready",
                "robot": "t"
              },
              {
                "kind": "not",
                "condition": {
                  "kind": "robot_at",
                  "robot": "t",
                  "location": "dst"
                }
              }
            ]
          },
          "else": [
            {
              "kind": "communicate",
              "robot": "a",
              "channel": "ops",
              "message": "no tugger"
            },
            {
              "kind": "fail",
              "reason": "no tugger is free"
            }
          ]
        },
        {
          "kind": "move",
          "robot": "t",
          "target": "dst"
        }
      ]
    }
  ]
}
