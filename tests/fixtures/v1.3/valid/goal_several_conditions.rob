// RoboLang v1.3 fixture: valid
// expect: ok
// why: a goal is a list of conditions, an implicit conjunction

robolang 1.3;

task t(robot r, object box, location src, location dst, region cell, sensor cam) {
    goal {
        object_at box dst;
        robot_at r dst;
        region_clear cell;
    }
    plan {
        move r to dst;
    }
}
