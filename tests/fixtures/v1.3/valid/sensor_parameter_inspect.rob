// RoboLang v1.3 fixture: valid
// expect: ok
// why: inspect ... using takes a sensor parameter

robolang 1.3;

task t(robot r, object box, location src, location dst, region cell, sensor cam) {
    goal {
        object_at box dst;
    }
    plan {
        inspect r box using cam;
        move r to dst;
    }
}
