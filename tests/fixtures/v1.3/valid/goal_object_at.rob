// RoboLang v1.3 fixture: valid
// expect: ok
// why: a goal block with the smallest useful goal: the box ends at the destination

robolang 1.3;

task t(robot r, object box, location src, location dst, region cell, sensor cam) {
    pre {
        robot_ready r;
    }
    goal {
        object_at box dst;
    }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
