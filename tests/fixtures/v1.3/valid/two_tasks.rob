// RoboLang v1.3 fixture: valid
// expect: ok
// why: each task has its own goal

robolang 1.3;

task first(robot r, object box, location src, location dst, region cell, sensor cam) {
    goal {
        robot_at r src;
    }
    plan {
        move r to src;
    }
}

task second(robot r, object box, location src, location dst, region cell, sensor cam) {
    goal {
        robot_at r dst;
    }
    plan {
        move r to dst;
    }
}
