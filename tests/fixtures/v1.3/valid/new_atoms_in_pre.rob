// RoboLang v1.3 fixture: valid
// expect: ok
// why: the outcome atoms are also conditions in pre

robolang 1.3;

task t(robot r, object box, location src, location dst, region cell, sensor cam) {
    pre {
        object_at box src;
        robot_at r src;
        not holding r box;
    }
    goal {
        object_at box dst;
    }
    plan {
        move r to dst;
    }
}
