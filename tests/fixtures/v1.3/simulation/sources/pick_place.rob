// LANG-2 simulation fixture (spec/robolang-v1.3.md section 8)
robolang 1.3;

task pick_place(robot r, object box, location src, location dst) {
    pre { object_at box src; }
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
