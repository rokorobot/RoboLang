// RoboLang v2.3 fixture: invalid
// expect: error E330 (static) line 10
// why: the clock is not a world fact of a candidate

robolang 2.3;

task t(robot a, robot b, location dst) {
    goal { robot_at s dst; }
    plan {
        choose robot s from (a, b) where robot_ready s and clock_time >= 09:00 else { fail "none"; }
        move s to dst;
    }
}
