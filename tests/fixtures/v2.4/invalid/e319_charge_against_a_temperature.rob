// RoboLang v2.4 fixture: invalid
// expect: error E319 (static) line 11
// why: A charge is not compared with a temperature.

robolang 2.4;

task t(robot r, location dest, location dock) {
    goal { robot_at r dest; }
    plan {
        measure r charge as c;
        if c < 25 degC { move r to dock; } else { move r to dest; }
    }
}
