{
  "ir_schema": "robolang.task-ir",
  "ir_schema_version": "1.12",
  "language_version": "2.4",
  "tasks": [
    {
      "name": "t",
      "parameters": [
        {
          "name": "r",
          "type": "robot"
        },
        {
          "name": "dest",
          "type": "location"
        },
        {
          "name": "dock",
          "type": "location"
        }
      ],
      "safety": [],
      "preconditions": [],
      "goal": [
        {
          "kind": "robot_at",
          "robot": "r",
          "location": "dest"
        }
      ],
      "steps": [
        {
          "kind": "wait_until",
          "condition": {
            "kind": "compare",
            "left": {
              "kind": "charge",
              "robot": "ghost"
            },
            "op": ">=",
            "right": {
              "kind": "quantity",
              "value": "80",
              "unit": "%"
            }
          },
          "timeout": {
            "value": "40",
            "unit": "min"
          },
          "else": [
            {
              "kind": "fail",
              "reason": "the battery is not at 80 percent in time"
            }
          ]
        },
        {
          "kind": "move",
          "robot": "r",
          "target": "dest"
        }
      ]
    }
  ]
}
