// RoboLang v1.1 fixture: valid
// expect: ok
// why: several tasks in one file; execution needs explicit selection (RL-11D)

task handover(robot arm, object box, location pickup, location handoff) {
    pre { object_exists box; }
    plan {
        move arm to pickup;
        grasp arm box;
        move arm to handoff;
        communicate arm to "mobile_bot" with "HANDOFF_READY";
    }
}

task retreat(robot arm, location home) {
    plan {
        move arm to home;
    }
}
