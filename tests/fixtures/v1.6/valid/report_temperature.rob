// RoboLang v1.6 fixture: valid
// expect: ok
// why: measuring a temperature, deciding on it and sending it as a typed value (decision 0036 V2, V6, V8)

robolang 1.6;

task report_temperature(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        move r to bench;
        measure r temperature of pan using probe as t else {
            fail "no temperature reading";
        }
        if t < 60 degC {
            communicate r to "ops" with t;
        } else {
            communicate r to "ops" with "pan still hot";
        }
    }
}
