// RoboLang v1.6 fixture: valid
// expect: ok
// why: a label is compared with == and != against a string or another label (V6)

robolang 1.6;

task check_label(robot r, object tube, object spare, sensor scanner, location bench) {
    goal { robot_at r bench; }
    plan {
        measure r label of tube using scanner as lot;
        measure r label of spare using scanner as other;
        if lot == "LOT-7731" and lot != other {
            move r to bench;
        } else {
            fail "wrong lot";
        }
    }
}
