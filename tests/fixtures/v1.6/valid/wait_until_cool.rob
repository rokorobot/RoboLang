// RoboLang v1.6 fixture: valid
// expect: ok
// why: a live reading in wait until, with a handler for the timeout (V4)

robolang 1.6;

task wait_until_cool(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        move r to bench;
        wait until temperature of pan using probe < 60 degC timeout 10 min else {
            fail "pan did not cool";
        }
    }
}
