// RoboLang v1.6 fixture: invalid
// expect: error E320 (static) line 11
// why: labels have no order

robolang 1.6;

task t(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        measure r label of pan using probe as lot;
        if lot < "M" { move r to bench; }
    }
}
