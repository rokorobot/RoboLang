// RoboLang v1.6 fixture: invalid
// expect: error E319 (static) line 12
// why: two bindings of different kinds do not compare

robolang 1.6;

task t(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        measure r temperature of pan using probe as t;
        measure r mass of pan using probe as m;
        if t < m { move r to bench; }
    }
}
