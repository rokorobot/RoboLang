// RoboLang v1.6 fixture: invalid
// expect: error E317 (static) line 13
// why: a binding made inside an if branch is not visible after it

robolang 1.6;

task t(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        if object_exists pan {
            measure r mass of pan using probe as m;
        }
        communicate r to "ops" with m;
    }
}
