// RoboLang v1.6 fixture: invalid
// expect: error E101 (lexical) line 11
// why: '=' alone is not an operator: the comparisons are < <= > >= == !=

robolang 1.6;

task t(robot r, object pan, sensor probe, location bench) {
    goal { robot_at r bench; }
    plan {
        measure r temperature of pan using probe as t;
        if t = 5 degC { move r to bench; }
    }
}
