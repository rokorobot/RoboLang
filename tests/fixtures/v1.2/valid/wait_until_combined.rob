// RoboLang v1.2 fixture: valid
// expect: ok
// why: a combined condition in wait until; timeout ends it

robolang 1.2;

task t(robot r, object box, location dst, region cell, region left, region right) {
    plan {
        wait until (region_clear left or region_clear right) and sensor_ok "camera_top" timeout 30s;
        wait until not object_exists box timeout 500ms;
        move r to dst;
    }
}
