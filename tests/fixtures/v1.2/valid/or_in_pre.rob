// RoboLang v1.2 fixture: valid
// expect: ok
// why: an or of three regions

robolang 1.2;

task t(robot r, object box, location dst, region cell, region left, region right) {
    pre {
        region_clear cell or region_clear left or region_clear right;
    }
    plan {
        move r to dst;
    }
}
