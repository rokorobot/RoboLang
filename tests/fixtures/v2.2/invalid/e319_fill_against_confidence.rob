// RoboLang v2.2 fixture: invalid
// expect: error E319 (static) line 13
// why: fill and confidence are different kinds, though both are in % (D3)

robolang 2.2;

task t(robot r, object shelf, location aisle, sensor cam, sensor tag) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r fill of shelf using cam as level;
        measure r confidence of shelf using cam as sure;
        if level < sure { communicate r to "lead" with "x"; }
    }
}
