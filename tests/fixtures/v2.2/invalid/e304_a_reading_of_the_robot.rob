// RoboLang v2.2 fixture: invalid
// expect: error E304 (static) line 11
// why: a robot is not an object or a location: no reading of the robot itself (D9)

robolang 2.2;

task t(robot r, object shelf, location aisle, sensor cam, sensor tag) {
