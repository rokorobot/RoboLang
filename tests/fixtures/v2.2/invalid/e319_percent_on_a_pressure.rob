// RoboLang v2.2 fixture: invalid
// expect: error E319 (static) line 12
// why: % is a unit of fill and confidence, not of pressure

robolang 2.2;

task t(robot r, object gauge, location aisle, sensor cam, sensor tag) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r pressure of gauge using cam as p;
        if p > 6 % { communicate r to "lead" with "x"; }
    }
}
