// RoboLang v2.0 fixture: valid
// expect: ok
// why: a time-of-day until is a hard bound with no count (clarification 2)

robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan { move r to far; wait for 5 s; move r to home; }
}

mission rounds_until_ten(robot r, location home, location far) {
    repeat {
        run round(r, home, far);
    } until clock_time >= 22:00;
}
