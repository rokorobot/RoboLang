// RoboLang v2.0 fixture: valid
// expect: ok
// why: retry N with no repeat: one run, at most N more (clarification 5)

robolang 2.0;

task transfer(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan { move r to src; grasp r item; move r to dst; place r item at dst; }
}

mission carry_part(robot r, object item, location src, location dst) {
    run transfer(r, item, src, dst);
    on failure { retry 12; }
}
