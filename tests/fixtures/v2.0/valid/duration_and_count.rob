// RoboLang v2.0 fixture: valid
// expect: ok
// why: both bounds, `for at most` in minutes (there is no hour unit)

robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan { move r to far; wait for 5 s; move r to home; }
}

mission rounds(robot r, location home, location far, region quay) {
    repeat at most 100 runs, for at most 480 min {
        run round(r, home, far);
    } until region_clear quay;
    on failure { stop; }
}
