// RoboLang v2.0 fixture: invalid
// expect: error E325 (static) line 14
// why: a retry count is at most 100

robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan { move r to far; wait for 5 s; move r to home; }
}

mission m(robot r, location home, location far, region quay) {
    run round(r, home, far);
    on failure { retry 101; }
}
