// RoboLang v1.7 fixture: valid
// expect: ok
// why: region limits and max_speed mix in any order; a region is named once

robolang 1.7;

task weed(robot w, location row, region field, region road, region pit) {
    @safety in_region field;
    @safety max_speed 0.5 m/s;
    @safety no_go_region road;
    @safety no_go_region pit;
    goal { robot_at w row; }
    plan { move w to row; }
}
