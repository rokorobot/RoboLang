// RoboLang v2.1 fixture: invalid
// expect: error E211 (syntax) line 11
// why: the condition is 2.1 only: a 2.0 file still reads message_received as reserved (E211)

robolang 2.0;

task feed(robot r, object tote, location src, location hold, location line) {
    goal { object_at tote line; }
    plan {
        move r to src; grasp r tote; move r to hold;
        wait until message_received "line" with "X" timeout 10 min else { fail "no"; }
        move r to line; place r tote at line;
    }
}
