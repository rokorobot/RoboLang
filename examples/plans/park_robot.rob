// examples/plans/park_robot.rob
// A second plan in the robot's library, with a different goal: it never matches a box goal.
robolang 1.3;

task park_robot(robot r, location home) {
    pre {
        robot_ready r;
    }

    goal {
        robot_at r home;
    }

    plan {
        move r to home;
    }
}
