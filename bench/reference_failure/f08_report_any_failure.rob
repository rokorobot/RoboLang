// bench/reference_failure/f08_report_any_failure.rob: the RoboLang 1.5 answer
robolang 1.5;

task deliver(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        move r to src else {
            communicate r to "ops" with "job failed";
            fail "job failed";
        }
        grasp r box else {
            communicate r to "ops" with "job failed";
            fail "job failed";
        }
        move r to dst else {
            communicate r to "ops" with "job failed";
            fail "job failed";
        }
        place r box at dst else {
            communicate r to "ops" with "job failed";
            fail "job failed";
        }
    }
}
