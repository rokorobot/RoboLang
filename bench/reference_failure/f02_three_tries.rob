// bench/reference_failure/f02_three_tries.rob: the RoboLang 1.5 answer
robolang 1.5;

task fetch(robot r, object v, location src, location dst) {
    goal { object_at v dst; }
    plan {
        move r to src;
        grasp r v else {
            grasp r v else {
                grasp r v;
            }
        }
        move r to dst;
        place r v at dst;
    }
}
