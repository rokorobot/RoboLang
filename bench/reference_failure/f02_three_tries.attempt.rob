// bench/reference_failure/f02_three_tries.attempt.rob: the 1.5 answer under 1.4, which has no failure handlers
robolang 1.4;

task fetch(robot r, object v, location src, location dst) {
    goal { object_at v dst; }
    plan {
        move r to src;
        grasp r v else {
            grasp r v else {
                grasp r v;
            }
        }
        move r to dst;
        place r v at dst;
    }
}
