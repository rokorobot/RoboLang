// bench/reference_failure/f06_skip_inspection.attempt.rob: the 1.5 answer under 1.4, which has no failure handlers
robolang 1.4;

task check(robot r, object v, location src, location dst, sensor s) {
    goal { object_at v dst; }
    plan {
        wait until sensor_ok s timeout 5 s else {
            communicate r to "lab" with "spectro unavailable";
        }
        if sensor_ok s {
            inspect r v using s;
        }
        move r to src;
        grasp r v;
        move r to dst;
        place r v at dst;
    }
}
