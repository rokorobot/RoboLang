// bench/reference_hard/x_retry_grasp.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task persistent(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        move r to src;
        retry {
            grasp r box;
        }
        move r to dst;
        place r box at dst;
    }
}
