// bench/reference_hard/x_wait_forever.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task carry(robot r, object c, location src, location dst, region aisle) {
    goal { object_at c dst; }
    plan {
        wait until region_clear aisle;
        move r to src;
        grasp r c;
        move r to dst;
        place r c at dst;
    }
}
