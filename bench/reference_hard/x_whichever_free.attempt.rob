// bench/reference_hard/x_whichever_free.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task move_box(robot a, robot b, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        r = first_ready(a, b);
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
