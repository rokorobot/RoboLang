// bench/reference_hard/k_wait_giveup.rob: hand-written reference solution
robolang 1.3;

task carry(robot r, object box, location src, location dst, region aisle) {
    goal { object_at box dst; }
    plan {
        wait until region_clear aisle timeout 12 s;
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
