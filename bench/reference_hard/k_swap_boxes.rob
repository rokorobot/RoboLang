// bench/reference_hard/k_swap_boxes.rob: hand-written reference solution
robolang 1.3;

task swap(robot r, object a, object b, location sa, location sb, location tmp) {
    goal {
        object_at a sb;
        object_at b sa;
    }
    plan {
        move r to sa;
        grasp r a;
        move r to tmp;
        place r a at tmp;
        move r to sb;
        grasp r b;
        move r to sa;
        place r b at sa;
        move r to tmp;
        grasp r a;
        move r to sb;
        place r a at sb;
    }
}
