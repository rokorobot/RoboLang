// bench/reference_hard/x_elapsed_time.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task timed(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
        communicate r to "ops" with elapsed_seconds;
    }
}
