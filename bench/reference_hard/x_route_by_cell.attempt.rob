// bench/reference_hard/x_route_by_cell.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task route(robot r, object box, location src, location a, location b, region cell) {
    goal { object_at box a or object_at box b; }
    plan {
        if region_clear cell {
            move r to src; grasp r box; move r to a; place r box at a;
        } else {
            move r to src; grasp r box; move r to b; place r box at b;
        }
    }
}
