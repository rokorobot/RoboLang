// bench/reference_hard/n_speed_over_max.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task carry(robot r, object box, location src, location dst) {
    @safety max_speed 2 m/s;
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
