// bench/reference_hard/m_same_shelf.rob: hand-written reference solution
robolang 1.3;

task gather(robot r, object a, object b, location src_b, location dst) {
    goal {
        object_at a dst;
        object_at b dst;
    }
    plan {
        move r to src_b;
        grasp r b;
        move r to dst;
        place r b at dst;
    }
}
