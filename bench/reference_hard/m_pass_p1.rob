// Reference revised after the independent label review: arm_b must receive p1.
robolang 1.3;

task deliver(robot r, robot receiver, object box, location src, location dst) {
    goal { holding receiver box; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
        move receiver to dst;
        grasp receiver box;
    }
}
