// bench/reference_hard/m_one_vial_scanner.rob: hand-written reference solution
robolang 1.3;

task deliver(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
