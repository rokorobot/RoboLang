// bench/reference_hard/x_wait_message.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.3;

task after_message(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        wait until message_received "handoff" timeout 60 s;
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
