{
  "id": "d7_wait_or_nothing",
  "prompt": "Wait up to 45 seconds for the hot zone to clear. If it does, have the helper arm take tray A from the oven to the pass; if it doesn't, do nothing.",
  "world": "bench/worlds/kitchen.json",
  "group": "decoy",
  "expect": {
    "decision": "program",
    "category": "none"
  },
  "expected_goal": [
    [
      "rl:thing:tray_a",
      "located_in",
      "rl:place:pass"
    ]
  ],
  "probes": [
    {
      "name": "hot_zone_stays_busy",
      "world_patch": {
        "events": []
      },
      "expect": "not_succeeded"
    }
  ],
  "tags": [
    "looks_unsupported",
    "wait_until"
  ],
  "limitations": "The clear-world run is feasible; in the never-clear probe a timeout fails and leaves the tray untouched. This does not demonstrate a successful alternate branch or general if/else.",
  "expected_action_sequences": [
    {
      "steps": [
        {
          "kind": "grasp",
          "robot": "helper_arm",
          "obj": "tray_a"
        },
        {
          "kind": "place",
          "robot": "helper_arm",
          "obj": "tray_a",
          "target": "pass"
        }
      ]
    },
    {
      "steps": [
        {
          "kind": "wait_until",
          "condition": {
            "kind": "region_clear",
            "region": "hot_zone"
          }
        },
        {
          "kind": "grasp",
          "robot": "helper_arm",
          "obj": "tray_a"
        }
      ]
    }
  ]
}
