// bench/reference_choose/p05_any_part_from_the_conveyor.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.2;

task one_part(robot arm, location conveyor, location bin) {
    goal { object_at part bin; }
    plan {
        choose object part from objects at conveyor else { fail "the conveyor is empty"; }          // @choice part=p1
        move arm to conveyor;
        grasp arm part;
        move arm to bin;
        place arm part at bin;
    }
}
