// bench/reference_choose/p05_any_part_from_the_conveyor.rob: hand-written reference (RoboLang 2.3)
robolang 2.3;

task one_part(robot arm, location conveyor, location bin) {
    goal { object_at part bin; }
    plan {
        choose object part from objects at conveyor else { fail "the conveyor is empty"; }
        move arm to conveyor;
        grasp arm part;
        move arm to bin;
        place arm part at bin;
    }
}
