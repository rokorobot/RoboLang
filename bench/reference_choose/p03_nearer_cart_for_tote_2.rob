// bench/reference_choose/p03_nearer_cart_for_tote_2.rob: hand-written reference (RoboLang 2.3)
robolang 2.3;

task to_closer(robot r, object tote, location src, location a, location b, location ref) {
    goal { object_at tote dst; }
    plan {
        choose location dst from (a, b) nearest to ref else { fail "no place"; }
        move r to src;
        grasp r tote;
        move r to dst;
        place r tote at dst;
    }
}
