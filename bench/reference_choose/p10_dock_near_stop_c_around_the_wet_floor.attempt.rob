// bench/reference_choose/p10_dock_near_stop_c_around_the_wet_floor.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.2;

task go_to_dock(robot r, location d1, location d2, location d3, location ref, region wet) {
    @safety no_go_region wet;
    goal { robot_at r dock; }
    plan {
        choose location dock from (d1, d2, d3) nearest to ref else { fail "no dock"; }              // @choice dock=d1
        move r to dock;
    }
}
