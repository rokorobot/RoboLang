// bench/reference_regions/c04_speed_only.rob: hand-written reference
robolang 1.6;

task haul(robot r, object c, location src, location dst) {
    @safety max_speed 0.5 m/s;
    goal { object_at c dst; }
    plan {
        move r to src;
        grasp r c;
        move r to dst;
        place r c at dst;
    }
}
