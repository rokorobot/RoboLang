// bench/reference_regions/r09_crate_around_aisle_and_cell.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task haul(robot r, object c, location src, location dst, region aisle, region cell) {
    @safety no_go_region aisle;
    @safety no_go_region cell;
    goal { object_at c dst; }
    plan {
        move r to src;
        grasp r c;
        move r to dst;
        place r c at dst;
    }
}
