// bench/reference_regions/r06_field_clear_or_other_row.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task to_row(robot r, location a, location b, region field, region road) {
    @safety no_go_region road;
    plan {
        if region_clear field {
            goal { robot_at r a; }
            move r to a;
        } else {
            goal { robot_at r b; }
            move r to b;
        }
    }
}
