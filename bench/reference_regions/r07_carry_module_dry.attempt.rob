// bench/reference_regions/r07_carry_module_dry.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task install(robot r, object m, location src, location dst, region wet) {
    @safety no_go_region wet;
    goal { object_at m dst; }
    plan {
        move r to src;
        grasp r m;
        move r to dst;
        place r m at dst;
    }
}
