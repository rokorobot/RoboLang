// bench/reference_regions/r03_field_not_road.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task to_row(robot r, location dst, region field, region road) {
    @safety in_region field;
    @safety no_go_region road;
    goal { robot_at r dst; }
    plan { move r to dst; }
}
