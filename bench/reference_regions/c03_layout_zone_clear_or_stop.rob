// bench/reference_regions/c03_layout_zone_clear_or_stop.rob: hand-written reference
robolang 1.6;

task lay_out(robot r, location dst, region zone) {
    plan {
        if region_clear zone {
            goal { robot_at r dst; }
            move r to dst;
        } else {
            communicate r to "site" with "layout zone busy";
            fail "layout zone busy";
        }
    }
}
