// bench/reference_regions/x01_first_leg_only.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task via_hall(robot r, location hall, location dst, region wet) {
    goal { robot_at r dst; }
    plan {
        move r to hall no_go_region wet;
        move r to dst;
    }
}
