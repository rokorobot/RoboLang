// bench/reference_regions/r05_slow_and_dry.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task to_dock(robot r, location dst, region wet) {
    @safety max_speed 0.5 m/s;
    @safety no_go_region wet;
    goal { robot_at r dst; }
    plan { move r to dst; }
}
