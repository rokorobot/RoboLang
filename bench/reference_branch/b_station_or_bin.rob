// bench/reference_branch/b_station_or_bin.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task sort(robot r, object p, location src, location a, location b, region fence) {
    plan {
        if region_clear fence {
            goal { object_at p a; }
            move r to src;
            grasp r p;
            move r to a;
            place r p at a;
        } else {
            goal { object_at p b; }
            move r to src;
            grasp r p;
            move r to b;
            place r p at b;
        }
    }
}
