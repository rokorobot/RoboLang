// bench/reference_branch/c_if_ready_only.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object box, location src, location dst) {
    pre { robot_ready r; }
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
