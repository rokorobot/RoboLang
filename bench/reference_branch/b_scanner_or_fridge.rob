// bench/reference_branch/b_scanner_or_fridge.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task scan(robot r, object v, location src, location a, location b, sensor s) {
    plan {
        move r to src;
        grasp r v;
        if sensor_ok s {
            goal { object_at v a; }
            move r to a;
            place r v at a;
        } else {
            goal { object_at v b; }
            move r to b;
            place r v at b;
        }
    }
}
