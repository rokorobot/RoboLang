// bench/reference_branch/b_arm_b_or_amr.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task bring(robot r1, robot r2, object p, location src, location dst) {
    goal { object_at p dst; }
    plan {
        if robot_ready r1 {
            move r1 to src;
            grasp r1 p;
            move r1 to dst;
            place r1 p at dst;
        } else {
            move r2 to src;
            grasp r2 p;
            move r2 to dst;
            place r2 p at dst;
        }
    }
}
