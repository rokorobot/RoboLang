// bench/reference_branch/b_ready_robot_goes.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task visit(robot a, robot b, location dst) {
    plan {
        if robot_ready a {
            goal { robot_at a dst; }
            move a to dst;
        } else {
            goal { robot_at b dst; }
            move b to dst;
        }
    }
}
