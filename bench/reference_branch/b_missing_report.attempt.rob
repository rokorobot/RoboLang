// bench/reference_branch/b_missing_report.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task deliver(robot r, object box, location src, location dst) {
    plan {
        if object_at box src {
            goal { object_at box dst; }
            move r to src;
            grasp r box;
            move r to dst;
            place r box at dst;
        } else {
            communicate r to "alerts" with "box1 missing";
            fail "box1 missing";
        }
    }
}
