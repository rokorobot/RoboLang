// bench/reference_branch/b_crate_or_charge.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task tidy(robot r, object c, location src, location dst, location charge) {
    plan {
        if object_at c src {
            goal { object_at c dst; }
            move r to src;
            grasp r c;
            move r to dst;
            place r c at dst;
        } else {
            goal { robot_at r charge; }
            move r to charge;
        }
    }
}
