// bench/reference_branch/b_amr_at_dock.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task deliver(robot m, robot a, object box, location dock, location src, location dst) {
    goal { object_at box dst; }
    plan {
        if robot_at m dock {
            move m to src;
            grasp m box;
            move m to dst;
            place m box at dst;
        } else {
            move a to src;
            grasp a box;
            move a to dst;
            place a box at dst;
        }
    }
}
