// bench/reference_branch/c_spectro_ready.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object v, location src, location dst, sensor s) {
    goal { object_at v dst; }
    plan {
        wait until sensor_ok s timeout 10s;
        move r to src;
        grasp r v;
        move r to dst;
        place r v at dst;
    }
}
