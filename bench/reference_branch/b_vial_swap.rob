// bench/reference_branch/b_vial_swap.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task spin(robot r, object v2, object v1, location fridge, location bench, location dst) {
    plan {
        if object_at v2 fridge {
            goal { object_at v2 dst; }
            move r to fridge;
            grasp r v2;
            move r to dst;
            place r v2 at dst;
        } else {
            goal { object_at v1 dst; }
            move r to bench;
            grasp r v1;
            move r to dst;
            place r v1 at dst;
        }
    }
}
