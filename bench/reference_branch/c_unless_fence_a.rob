// bench/reference_branch/c_unless_fence_a.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object p, location src, location dst, region fence) {
    pre { region_clear fence; }
    goal { object_at p dst; }
    plan {
        move r to src;
        grasp r p;
        move r to dst;
        place r p at dst;
    }
}
