// bench/reference_branch/b_both_parts.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task feed(robot r, object a, object b, object c, location src, location dst) {
    plan {
        if object_at a src and object_at b src {
            goal { object_at a dst; }
            move r to src;
            grasp r a;
            move r to dst;
            place r a at dst;
        } else {
            goal { object_at c dst; }
            move r to src;
            grasp r c;
            move r to dst;
            place r c at dst;
        }
    }
}
