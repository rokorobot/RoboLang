// bench/reference_branch/b_fence_b_route.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task route(robot r, object p, location src, location a, location b, region fence) {
    plan {
        move r to src;
        grasp r p;
        if region_clear fence {
            goal { object_at p a; }
            move r to a;
            place r p at a;
        } else {
            goal { object_at p b; }
            move r to b;
            place r p at b;
        }
    }
}
