// bench/reference_branch/b_box_or_home.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task tidy(robot r, object box, location src, location dst, location home) {
    plan {
        if object_at box src {
            goal { object_at box dst; }
            move r to src;
            grasp r box;
            move r to dst;
            place r box at dst;
        } else {
            goal { robot_at r home; }
            move r to home;
        }
    }
}
