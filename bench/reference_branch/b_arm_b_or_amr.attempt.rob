// bench/reference_branch/b_arm_b_or_amr.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task bring(robot r1, robot r2, object p, location src, location dst) {
    plan {
        if robot_ready r1 {
            move r1 to src;
            grasp r1 p;
            move r1 to dst;
            place r1 p at dst;
        } else {
            move r2 to src;
            grasp r2 p;
            move r2 to dst;
            place r2 p at dst;
        }
    }
}
