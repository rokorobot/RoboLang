// bench/reference_branch/b_amr_at_dock.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task deliver(robot m, robot a, object box, location dock, location src, location dst) {
    goal { object_at box dst; }
    plan {
        if robot_at m dock {
            move m to src;
            grasp m box;
            move m to dst;
            place m box at dst;
        } else {
            move a to src;
            grasp a box;
            move a to dst;
            place a box at dst;
        }
    }
}
