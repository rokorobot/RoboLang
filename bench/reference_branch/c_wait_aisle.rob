// bench/reference_branch/c_wait_aisle.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object c, location src, location dst, region aisle) {
    goal { object_at c dst; }
    plan {
        wait until region_clear aisle timeout 20s;
        move r to src;
        grasp r c;
        move r to dst;
        place r c at dst;
    }
}
