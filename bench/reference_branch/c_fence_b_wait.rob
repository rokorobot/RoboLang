// bench/reference_branch/c_fence_b_wait.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object p, location src, location dst, region fence) {
    goal { object_at p dst; }
    plan {
        wait until region_clear fence timeout 30s;
        move r to src;
        grasp r p;
        move r to dst;
        place r p at dst;
    }
}
