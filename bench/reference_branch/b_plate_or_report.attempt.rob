// bench/reference_branch/b_plate_or_report.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task fetch(robot r, object p, location src, location dst) {
    plan {
        if object_at p src {
            goal { object_at p dst; }
            move r to src;
            grasp r p;
            move r to dst;
            place r p at dst;
        } else {
            communicate r to "lab" with "plate1 not in storage";
            fail "plate1 not in storage";
        }
    }
}
