// bench/reference_branch/b_crate_or_charge.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task tidy(robot r, object c, location src, location dst, location charge) {
    plan {
        if object_at c src {
            goal { object_at c dst; }
            move r to src;
            grasp r c;
            move r to dst;
            place r c at dst;
        } else {
            goal { robot_at r charge; }
            move r to charge;
        }
    }
}
