// bench/reference_branch/b_missing_report.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task deliver(robot r, object box, location src, location dst) {
    plan {
        if object_at box src {
            goal { object_at box dst; }
            move r to src;
            grasp r box;
            move r to dst;
            place r box at dst;
        } else {
            communicate r to "alerts" with "box1 missing";
            fail "box1 missing";
        }
    }
}
