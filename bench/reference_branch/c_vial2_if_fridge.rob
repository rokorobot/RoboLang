// bench/reference_branch/c_vial2_if_fridge.rob: hand-written reference solution
robolang 1.3;

task t(robot r, object v, location src, location dst) {
    pre { object_at v src; }
    goal { object_at v dst; }
    plan {
        move r to src;
        grasp r v;
        move r to dst;
        place r v at dst;
    }
}
