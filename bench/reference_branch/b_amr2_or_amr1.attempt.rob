// bench/reference_branch/b_amr2_or_amr1.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task haul(robot r1, robot r2, object c, location src, location dst) {
    goal { object_at c dst; }
    plan {
        if robot_ready r1 {
            move r1 to src;
            grasp r1 c;
            move r1 to dst;
            place r1 c at dst;
        } else {
            move r2 to src;
            grasp r2 c;
            move r2 to dst;
            place r2 c at dst;
        }
    }
}
