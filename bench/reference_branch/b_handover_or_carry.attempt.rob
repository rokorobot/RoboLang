// bench/reference_branch/b_handover_or_carry.attempt.rob: the program with `if`; RoboLang 1.3 rejects it. Under `robolang 1.4;` it is the 1.4 reference (decision 0027)
robolang 1.3;

task pass_on(robot arm, robot mobile, object box, location src, location handoff, location dst, region zone) {
    plan {
        move arm to src;
        grasp arm box;
        if region_clear zone {
            goal { holding mobile box; }
            move arm to handoff;
            place arm box at handoff;
            move mobile to handoff;
            grasp mobile box;
        } else {
            goal { object_at box dst; }
            move arm to dst;
            place arm box at dst;
        }
    }
}
