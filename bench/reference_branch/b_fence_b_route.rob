// bench/reference_branch/b_fence_b_route.rob: the reference program (RoboLang 1.4, decision 0027)
robolang 1.4;

task route(robot r, object p, location src, location a, location b, region fence) {
    plan {
        move r to src;
        grasp r p;
        if region_clear fence {
            goal { object_at p a; }
            move r to a;
            place r p at a;
        } else {
            goal { object_at p b; }
            move r to b;
            place r p at b;
        }
    }
}
