// bench/bench/reference_ask/f07_thermo_then_dispatch.rob: hand-written
robolang 1.6;

task check(robot r, object o, sensor s, location src, location dst) {
    goal { robot_at r dst; }
    plan {
        wait until sensor_ok s timeout 10 s else {
            fail "the thermometer did not come online";
        }
        move r to src;
        measure r temperature of o using s as t;
        move r to dst;
    }
}
