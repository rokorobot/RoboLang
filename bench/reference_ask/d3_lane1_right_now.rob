// bench/reference_ask/d3_lane1_right_now.rob: hand-written
robolang 1.3;

task deliver(robot r, object o, location src, location dst, region z) {
    pre { region_clear z; }
    goal { object_at o dst; }
    plan {
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
