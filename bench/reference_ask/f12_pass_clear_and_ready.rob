// bench/reference_ask/f12_pass_clear_and_ready.rob: hand-written
robolang 1.3;

task deliver(robot r, object o, location src, location dst, region z) {
    pre { region_clear z and robot_ready r; }
    goal { object_at o dst; }
    plan {
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
