// bench/reference_ask/d4_corridor_busy.rob: hand-written
robolang 1.3;

task deliver(robot r, object o, location src, location dst, region z) {
    goal { object_at o dst; }
    plan {
        wait until region_clear z timeout 30 s;
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
