// Candidate reading: operator supplies 60 s.
robolang 1.3;

task deliver(robot r, object o, location src, location dst, region z) {
    goal { object_at o dst; }
    plan {
        wait until region_clear z timeout 60 s;
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
