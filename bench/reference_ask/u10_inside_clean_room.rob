// bench/reference_ask/u10_inside_clean_room.rob: hand-written reference
robolang 1.7;

task inside(robot r, object o, location src, location dst, region z) {
    @safety in_region z;
    goal { object_at o dst; }
    plan {
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
