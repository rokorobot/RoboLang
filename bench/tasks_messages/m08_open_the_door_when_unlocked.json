{
  "id": "m08_open_the_door_when_unlocked",
  "prompt": "With moxi1, take iv_kit_1 from the supply_closet to room_412, but only after channel \"supply\" has sent \"DOOR UNLOCKED\". Wait up to 10 minutes for it; then open closet_door, take the kit and bring it to room_412. If the message does not come, stop the job as failed.",
  "world": "bench/worlds/ward_1_4.json",
  "group": "message",
  "expect": {
