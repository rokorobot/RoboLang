// bench/reference_clock/k03_wait_for_0530.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task early_run(robot r, location dst) {
    goal { robot_at r dst; }
    plan {
        wait until clock_time >= 05:30 timeout 90 min else { fail "05:30 did not come in time"; }  // @clock
        move r to dst;
    }
}
