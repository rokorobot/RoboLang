// bench/reference_clock/x05_on_monday.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task monday_run(robot r, location dst) {
    goal { robot_at r dst; }
    plan {
        wait until clock_time >= 09:00 timeout 12 h else { fail "09:00 did not come in time"; }  // @clock
        move r to dst;
    }
}
