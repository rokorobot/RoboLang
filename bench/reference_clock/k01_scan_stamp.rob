// bench/reference_clock/k01_scan_stamp.rob: hand-written reference
robolang 1.9;

task scan_stamp(robot r, object box, location shelf, sensor camera) {
    goal { robot_at r shelf; }
    plan {
        move r to shelf;
        inspect r box using camera;
        measure r time as now;
        communicate r to "lead" with now;
    }
}
