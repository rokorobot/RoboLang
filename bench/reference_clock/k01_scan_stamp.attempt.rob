// bench/reference_clock/k01_scan_stamp.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task scan_stamp(robot r, object box, location shelf, sensor camera) {
    goal { robot_at r shelf; }
    plan {
        move r to shelf;
        inspect r box using camera;
        measure r time as now;                           // @clock
        communicate r to "lead" with now;                // @clock
    }
}
