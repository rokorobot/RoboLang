// bench/reference_clock/k04_job_elapsed.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task relocate_timed(robot r, object box, location src, location dst) {
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
        measure r elapsed as took;                       // @clock
        communicate r to "ops" with took;                // @clock
    }
}
