// bench/reference_clock/k07_time_and_open.rob: hand-written reference
robolang 1.9;

task fetch_before_six(robot r, object door, object kit, location closet, location dst) {
    goal { in_state door "open"; object_at kit dst; }
    plan {
        measure r time as now;
        if now < 18:00 {
            move r to closet;
            do r open door;
            grasp r kit;
            move r to dst;
            place r kit at dst;
        } else {
            communicate r to "charge_nurse" with "supplies closed";
            fail "supplies are closed";
        }
    }
}
