// bench/reference_clock/x01_every_night_round.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task night_round(robot r, location lobby, location home) {
    goal { robot_at r home; }
    plan {
        wait until clock_time >= 23:30 timeout 12 h else { fail "23:30 did not come in time"; }  // @clock
        move r to lobby;
        move r to home;
    }
}
