// bench/reference_clock/c03_pan_temperature.rob: hand-written reference
robolang 1.9;

task read_pan(robot r, object pan, sensor probe, location stove) {
    goal { robot_at r stove; }
    plan {
        move r to stove;
        measure r temperature of pan using probe as t;
        communicate r to "pass" with t;
    }
}
