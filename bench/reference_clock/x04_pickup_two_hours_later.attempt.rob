// bench/reference_clock/x04_pickup_two_hours_later.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.8;

task scan_pickup(robot r, object box, location shelf, sensor camera) {
    goal { robot_at r shelf; }
    plan {
        move r to shelf;
        inspect r box using camera;
        measure r time as pickup;                        // @clock
        communicate r to "lead" with pickup;             // @clock
    }
}
