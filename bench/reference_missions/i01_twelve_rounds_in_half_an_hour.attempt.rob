// bench/reference_missions/i01_twelve_rounds_in_half_an_hour.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        wait for 5 min;
        move r to home;
    }
}

mission rounds(robot r, location home, location far) {  // @mission
    repeat at most 12 runs, for at most 30 min {        // @mission
        run round(r, home, far);                        // @mission
    };                                                  // @mission
    on failure { stop; }                                // @mission
}                                                       // @mission
