// bench/reference_missions/m08_rounds_out_of_the_wet_floor.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task round(robot r, location home, location far, region wet) {
    @safety no_go_region wet;
    goal { robot_at r home; }
    plan {
        move r to far;
        move r to home;
    }
}

mission cleaning_rounds(robot r, location home, location far, region wet) {  // @mission
    repeat at most 25 runs {                                                 // @mission
        run round(r, home, far, wet);                                        // @mission
    };                                                                       // @mission
    on failure { stop; }                                                     // @mission
}                                                                            // @mission
