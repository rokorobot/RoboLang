// bench/reference_missions/c01_three_round_trips.mission.rob: the other accepted form of c01 (clarification 10)
robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        move r to home;
    }
}

mission three_rounds(robot r, location home, location far) {
    repeat at most 3 runs {
        run round(r, home, far);
    };
}
