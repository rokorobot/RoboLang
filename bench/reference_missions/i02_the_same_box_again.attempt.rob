// bench/reference_missions/i02_the_same_box_again.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task transfer(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}

mission carry_again(robot r, object item, location src, location dst) {  // @mission
    repeat at most 15 runs {                                             // @mission
        run transfer(r, item, src, dst);                                 // @mission
    };                                                                   // @mission
    on failure { stop; }                                                 // @mission
}                                                                        // @mission
