// bench/reference_missions/x06_until_it_is_cool.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task read_pan(robot r, object pan, sensor probe, location st) {
    goal { object_at pan st; }
    plan {
        move r to st;
        measure r temperature of pan using probe as t;
        communicate r to "pass" with t;
        wait for 1 min;
    }
}

mission cool_down(robot r, object pan, sensor probe, location st) {  // @mission
    repeat at most 30 runs {                                         // @mission
        run read_pan(r, pan, probe, st);                             // @mission
    } until temperature of pan using probe < 40 degC;                // @mission
    on failure { stop; }                                             // @mission
}                                                                    // @mission
