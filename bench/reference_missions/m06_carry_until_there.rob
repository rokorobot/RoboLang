// bench/reference_missions/m06_carry_until_there.rob: the 2.0 reference (decision 0041)
robolang 2.0;

task transfer(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}

mission carry_until_there(robot r, object item, location src, location dst) {
    repeat at most 15 runs {
        run transfer(r, item, src, dst);
    } until object_at item dst;
    on failure { continue; }
}
