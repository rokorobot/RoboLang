// bench/reference_missions/c02_grasp_once_more.rob: hand-written reference
robolang 1.9;

task carry_part(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item else {
            grasp r item;
        }
        move r to dst;
        place r item at dst;
    }
}
