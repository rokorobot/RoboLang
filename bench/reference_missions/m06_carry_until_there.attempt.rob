// bench/reference_missions/m06_carry_until_there.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task transfer(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}

mission carry_until_there(robot r, object item, location src, location dst) {  // @mission
    repeat at most 15 runs {                                                   // @mission
        run transfer(r, item, src, dst);                                       // @mission
    } until object_at item dst;                                                // @mission
    on failure { continue; }                                                   // @mission
}                                                                              // @mission
