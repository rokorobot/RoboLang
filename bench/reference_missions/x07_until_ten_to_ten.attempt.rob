// bench/reference_missions/x07_until_ten_to_ten.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        wait for 5 min;
        move r to home;
    }
}

mission rounds(robot r, location home, location far) {  // @mission
    repeat at most 40 runs {                            // @mission
        run round(r, home, far);                        // @mission
    } until clock_time >= 22:00;                        // @mission
    on failure { stop; }                                // @mission
}                                                       // @mission
