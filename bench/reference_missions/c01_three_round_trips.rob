// bench/reference_missions/c01_three_round_trips.rob: hand-written reference
robolang 2.0;

task three_rounds(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        move r to home;
        move r to far;
        move r to home;
        move r to far;
        move r to home;
    }
}
