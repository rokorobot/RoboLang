// bench/reference_missions/m05_alternate_the_carry.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task carry(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
        wait for 3 s;
    }
}

mission alternate(robot r, object item, location a, location b, region lane) {  // @mission
    repeat at most 24 runs {                                                    // @mission
        run carry(r, item, a, b);                                               // @mission
        run carry(r, item, b, a);                                               // @mission
    } until region_clear lane;                                                  // @mission
    on failure { stop; }                                                        // @mission
}                                                                               // @mission
