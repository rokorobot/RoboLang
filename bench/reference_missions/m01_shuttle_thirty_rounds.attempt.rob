// bench/reference_missions/m01_shuttle_thirty_rounds.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        move r to home;
    }
}

mission shuttle(robot r, location home, location far) {  // @mission
    repeat at most 30 runs {                             // @mission
        run round(r, home, far);                         // @mission
    };                                                   // @mission
    on failure { stop; }                                 // @mission
}                                                        // @mission
