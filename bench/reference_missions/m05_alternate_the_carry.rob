// bench/reference_missions/m05_alternate_the_carry.rob: the 2.0 reference (decision 0041)
robolang 2.0;

task carry(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
        wait for 3 s;
    }
}

mission alternate(robot r, object item, location a, location b, region lane) {
    repeat at most 24 runs {
        run carry(r, item, a, b);
        run carry(r, item, b, a);
    } until region_clear lane;
    on failure { stop; }
}
