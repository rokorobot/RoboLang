// bench/reference_missions/m08_rounds_out_of_the_wet_floor.rob: the 2.0 reference (decision 0041)
robolang 2.0;

task round(robot r, location home, location far, region wet) {
    @safety no_go_region wet;
    goal { robot_at r home; }
    plan {
        move r to far;
        move r to home;
    }
}

mission cleaning_rounds(robot r, location home, location far, region wet) {
    repeat at most 25 runs {
        run round(r, home, far, wet);
    };
    on failure { stop; }
}
