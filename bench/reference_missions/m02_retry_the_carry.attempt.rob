// bench/reference_missions/m02_retry_the_carry.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.9;

task transfer(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}

mission carry_part(robot r, object item, location src, location dst) {  // @mission
    run transfer(r, item, src, dst);                                    // @mission
    on failure { retry 12; }                                            // @mission
}                                                                       // @mission
