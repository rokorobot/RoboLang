// bench/reference_missions/x07_until_ten_to_ten.rob: the 2.0 reference (decision 0041)
robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        wait for 5 min;
        move r to home;
    }
}

mission rounds(robot r, location home, location far) {
    repeat at most 40 runs {
        run round(r, home, far);
    } until clock_time >= 22:00;
    on failure { stop; }
}
