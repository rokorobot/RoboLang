// bench/reference_missions/m07_rounds_until_quay_clear.rob: the 2.0 reference (decision 0041)
robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        wait for 5 s;
        move r to home;
    }
}

mission rounds(robot r, location home, location far, region quay) {
    repeat at most 12 runs {
        run round(r, home, far);
    } until region_clear quay;
    on failure { stop; }
}
