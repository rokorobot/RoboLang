// bench/reference_values/v14_two_limits.rob: hand-written reference
robolang 1.6;

task in_range(robot r, object pan, sensor probe, location src, location dst) {
    plan {
        move r to src;
        measure r temperature of pan using probe as t;
        if t >= 50 degC and t <= 70 degC {
            goal { object_at pan dst; }
            grasp r pan;
            move r to dst;
            place r pan at dst;
        } else {
            fail "pan 1 is not between 50 and 70 degC";
        }
    }
}
