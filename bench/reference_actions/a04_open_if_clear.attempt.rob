// bench/reference_actions/a04_open_if_clear.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.7;

task open_if_clear(robot r, object door, location oven, region pass) {
    plan {
        if region_clear pass {
            goal { robot_at r oven; }
            move r to oven;
            do r open door;
        } else {
            communicate r to "kitchen" with "pass busy";
            fail "the pass is busy";
        }
    }
}
