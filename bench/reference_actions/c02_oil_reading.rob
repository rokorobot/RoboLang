// bench/reference_actions/c02_oil_reading.rob: hand-written reference
robolang 1.7;

task read_oil(robot r, object oil, sensor probe, location fryer) {
    goal { robot_at r fryer; }
    plan {
        move r to fryer;
        measure r temperature of oil using probe as t;
        communicate r to "fry" with t;
    }
}
