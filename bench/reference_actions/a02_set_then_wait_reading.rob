// bench/reference_actions/a02_set_then_wait_reading.rob: hand-written reference
robolang 1.8;

task start_batch(robot r, object basket, object oil, sensor probe, location src, location fryer) {
    goal { in_state fryer "heating"; object_at basket fryer; }
    plan {
        move r to fryer;
        do r set fryer to 175 degC;
        wait until temperature of oil using probe > 170 degC timeout 60 s else { fail "the oil did not heat"; }
        move r to src;
        grasp r basket;
        move r to fryer;
        place r basket at fryer;
    }
}
