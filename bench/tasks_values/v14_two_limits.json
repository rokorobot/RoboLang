{
  "id": "v14_two_limits",
  "prompt": "Probe pan 1. Move it to the pass only if it is between 50 °C and 70 °C; otherwise leave it and stop.",
  "world": "bench/worlds/kitchen_values.json",
  "group": "value",
  "expect": {
    "decision": "program"
  },
  "expect_1_5": {
    "decision": "cannot",
    "category": "inexpressible"
  },
  "expect_1_6": {
    "decision": "program",
    "paths": [
      {
        "when": "pan 1 at 45 degC: below the range",
        "goals": [
          [
            [
              "rl:thing:pan_1",
              "located_in",
              "rl:place:stove"
            ]
          ],
          [
            [
              "rl:robot:chef_arm",
              "located_in",
              "rl:place:stove"
            ]
          ]
        ],
        "fails": true,
        "world_patch": {
          "objects": {
            "pan_1": {
              "properties": {
                "temperature": {
                  "value": "45",
                  "unit": "degC"
                }
              }
            }
          }
        }
      },
      {
        "when": "pan 1 at 60 degC",
        "goal": [
          [
            "rl:thing:pan_1",
            "located_in",
            "rl:place:pass"
          ]
        ],
        "world_patch": {
          "objects": {
            "pan_1": {
              "properties": {
                "temperature": {
                  "value": "60",
                  "unit": "degC"
                }
              }
            }
          }
        }
      },
      {
        "when": "pan 1 at 75 degC: above the range",
        "goals": [
          [
            [
              "rl:thing:pan_1",
              "located_in",
              "rl:place:stove"
            ]
          ],
          [
            [
              "rl:robot:chef_arm",
              "located_in",
              "rl:place:stove"
            ]
          ]
        ],
        "fails": true,
        "world_patch": {
          "objects": {
            "pan_1": {
              "properties": {
                "temperature": {
                  "value": "75",
                  "unit": "degC"
                }
              }
            }
          }
        }
      }
    ]
  },
  "tags": [
    "measure",
    "and"
  ],
  "why": "Two comparisons of one binding joined with `and` (0036 V6); `==` on a quantity is not allowed, so \"between\" is two bounds.",
  "expected_readings": [
    [
      "chef_arm",
      "temperature",
      "pan_1"
    ]
  ]
}
