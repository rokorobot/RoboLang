{
  "id": "v11_report_after_branch",
  "prompt": "Probe pan 1 with the chef arm. If it is below 60 °C, move it to the pass. Either way, send the reading to \"pass\" at the end.",
  "world": "bench/worlds/kitchen_values.json",
  "group": "value",
  "expect": {
    "decision": "program"
  },
  "expect_1_5": {
    "decision": "cannot",
    "category": "inexpressible"
  },
  "expect_1_6": {
    "decision": "program",
    "paths": [
      {
        "when": "pan 1 at 45 degC",
        "goal": [
          [
            "rl:thing:pan_1",
            "located_in",
            "rl:place:pass"
          ]
        ],
        "world_patch": {
          "objects": {
            "pan_1": {
              "properties": {
                "temperature": {
                  "value": "45",
                  "unit": "degC"
                }
              }
            }
          }
        }
      },
      {
        "when": "pan 1 at 80 degC: left on the stove",
        "goals": [
          [
            [
              "rl:thing:pan_1",
              "located_in",
              "rl:place:stove"
            ]
          ],
          [
            [
              "rl:robot:chef_arm",
              "located_in",
              "rl:place:stove"
            ]
          ]
        ],
        "world_patch": {
          "objects": {
            "pan_1": {
              "properties": {
                "temperature": {
                  "value": "80",
                  "unit": "degC"
                }
              }
            }
          }
        }
      }
    ]
  },
  "tags": [
    "measure",
    "if",
    "binding_scope"
  ],
  "why": "A binding is visible after the `if` that follows it: the reading is sent at the end on both paths (0036 V3).",
  "expected_readings": [
    [
      "chef_arm",
      "temperature",
      "pan_1"
    ]
  ],
  "expected_messages": [
    {
      "channel": "pass",
      "value_of": [
        "pan_1",
        "temperature"
      ]
    }
  ]
}
