// bench/v2/reference/i17_placed_and_held.rob: hand-written reference
robolang 1.3;

task both(robot r, object o, location src, location dst) {
    goal {
        object_at o dst;
        holding r o;
    }
    plan {
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
