// bench/v2/reference/d5_two_inspections.rob: hand-written reference
robolang 1.3;

task check_and_sink(robot c, robot h, object o, sensor cam, sensor probe, location src, location dst) {
    goal { object_at o dst; }
    plan {
        inspect c o using cam;
        inspect c o using probe;
        move h to src;
        grasp h o;
        move h to dst;
        place h o at dst;
    }
}
