// bench/v2/reference/i15_two_bowls_one_gripper.rob: hand-written reference
robolang 1.3;

task both(robot r, object a, object b, location la, location lb) {
    goal {
        holding r a;
        holding r b;
    }
    plan {
        move r to la;
        grasp r a;
        move r to lb;
        grasp r b;
    }
}
