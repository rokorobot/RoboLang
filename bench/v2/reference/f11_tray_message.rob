// bench/v2/reference/f11_tray_message.rob: hand-written reference
robolang 1.3;

task deliver(robot r, object o, location src, location dst) {
    goal { object_at o dst; }
    plan {
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
        communicate r to "pharmacy" with "TRAY READY";
    }
}
