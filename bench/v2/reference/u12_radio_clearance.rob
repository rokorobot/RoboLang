// bench/v2/reference/u12_radio_clearance.rob: hand-written reference
robolang 1.3;

task cleared(robot r, object o, location src, location dst) {
    goal { object_at o dst; }
    plan {
        wait until message_received "CLEARANCE" timeout 30 min;
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
