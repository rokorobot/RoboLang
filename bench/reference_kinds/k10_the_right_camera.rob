// bench/reference_kinds/k10_the_right_camera.rob: hand-written reference (RoboLang 2.2)
robolang 2.2;

task check_shelf(robot r, object shelf, sensor cam, location aisle) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r fill of shelf using cam as f;
        if f < 10 % {
            communicate r to "lead" with "shelf_3 is nearly empty";
        }
    }
}
