// bench/reference_kinds/i04_gauge_nine_is_not_there.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.1;

task read_gauge(robot r, object gauge, sensor cam, location base) {
    goal { robot_at r base; }
    plan {
        move r to base;
        measure r pressure of gauge using cam as p;                                                 // @reading
        if p > 6 bar {                                                                              // @reading
            communicate r to "maintenance" with "pump 9 over pressure";                             // @reading
        }                                                                                           // @reading
    }
}
