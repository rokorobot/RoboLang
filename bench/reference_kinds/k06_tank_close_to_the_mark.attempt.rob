// bench/reference_kinds/k06_tank_close_to_the_mark.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.1;

task check_tank(robot r, object tank, sensor cam, location farm) {
    goal { robot_at r farm; }
    plan {
        move r to farm;
        measure r fill of tank using cam as f;                                                      // @reading
        if f > 80 % {                                                                               // @reading
            communicate r to "maintenance" with "tank_2 is nearly full";                            // @reading
        }                                                                                           // @reading
    }
}
