// bench/reference_kinds/x04_average_fill.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.1;

task report_fill(robot r, object first, object second, sensor cam, location aisle) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r fill of first using cam as a;                                                     // @reading
        measure r fill of second using cam as b;                                                    // @reading
        communicate r to "lead" with a;                                                             // @reading
    }
}
