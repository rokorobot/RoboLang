// bench/reference_kinds/k01_restock_under_thirty_percent.rob: hand-written reference (RoboLang 2.2)
robolang 2.2;

task check_shelf(robot r, object shelf, sensor cam, location aisle) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r fill of shelf using cam as f;
        if f < 30 % {
            communicate r to "lead" with "restock shelf_2";
        }
    }
}
