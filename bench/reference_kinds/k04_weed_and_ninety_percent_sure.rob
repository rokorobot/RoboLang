// bench/reference_kinds/k04_weed_and_ninety_percent_sure.rob: hand-written reference (RoboLang 2.2)
robolang 2.2;

task weed_or_skip(robot r, object plant, sensor cam, location here) {
    goal { robot_at r here; }
    plan {
        move r to here;
        measure r label of plant using cam as what;
        measure r confidence of plant using cam as sure;
        if what == "weed" and sure >= 90 % {
            communicate r to "ops" with "weed confirmed";
        } else {
            communicate r to "ops" with "plant_7 skipped";
        }
    }
}
