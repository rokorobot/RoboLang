// bench/reference_kinds/k05_pump_one_below_450_kpa.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.1;

task read_gauge(robot r, object gauge, sensor cam, location pump) {
    goal { robot_at r pump; }
    plan {
        move r to pump;
        measure r pressure of gauge using cam as p;                                                 // @reading
        if p < 450 kPa {                                                                            // @reading
            communicate r to "maintenance" with "pump 1 low pressure";                              // @reading
        }                                                                                           // @reading
    }
}
