// bench/reference_kinds/k03_shelf_three_out_of_stock.rob: hand-written reference (RoboLang 2.2)
robolang 2.2;

task check_stock(robot r, object shelf, sensor reader, location aisle) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r count of shelf using reader as n;
        if n == 0 {
            communicate r to "lead" with "shelf_3 is out of stock";
        }
    }
}
