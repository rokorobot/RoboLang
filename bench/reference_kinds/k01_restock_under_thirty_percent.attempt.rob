// bench/reference_kinds/k01_restock_under_thirty_percent.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.1;

task check_shelf(robot r, object shelf, sensor cam, location aisle) {
    goal { robot_at r aisle; }
    plan {
        move r to aisle;
        measure r fill of shelf using cam as f;                                                     // @reading
        if f < 30 % {                                                                               // @reading
            communicate r to "lead" with "restock shelf_2";                                         // @reading
        }                                                                                           // @reading
    }
}
