// bench/reference_set3/a19_until_corridor.reading2.rob: hand-written
robolang 1.3;

task deliver(robot r, object o, location src, location dst, region z) {
    goal { object_at o dst; }
    plan {
        wait until region_clear z timeout 5 min;
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
