// bench/reference_set3/u11_wait_go.attempt.rob: hand-written
robolang 1.3;

task on_go(robot r, object o, location src, location dst) {
    goal { object_at o dst; }
    plan {
        wait until message_received "GO" timeout 10 min;
        move r to src;
        grasp r o;
        move r to dst;
        place r o at dst;
    }
}
