    "world_2_2": {
      "sensors": {
        "cam_crawler2": {
          "measures": {
            "fill": {
              "unit": "%",
              "uncertainty": "2",
              "contact": false
            }
          }
        }
      },
      "objects": {
        "tank_2": {
          "properties": {
            "fill": {
              "value": "90",
              "unit": "%"
            }
          }
        }
      }
    },
    "expected_readings": [
      [
        "crawler2",
        "fill",
        "tank_2"
      ]
    ],
    "expected_comparisons": [
      {
        "kind": "fill",
        "op": ">",
        "value": "80",
        "unit": "%"
      }
    ],
    "paths": [
      {
        "when": "tank_2 is 90 % full: above 80 %",
        "goal": [
          [
            "rl:robot:crawler2",
            "located_in",
            "rl:place:tank_farm"
          ]
        ],
        "messages": [
          [
            "maintenance",
            "tank_2 is nearly full"
          ]
        ],
        "world_patch": {
          "objects": {
            "tank_2": {
              "properties": {
                "fill": {
                  "value": "90",
                  "unit": "%"
                }
              }
            }
          }
        }
      },
      {
        "when": "tank_2 is 50 % full: not above 80 %",
        "goal": [
          [
            "rl:robot:crawler2",
            "located_in",
            "rl:place:tank_farm"
          ]
        ],
        "messages": [],
        "world_patch": {
          "objects": {
            "tank_2": {
              "properties": {
                "fill": {
                  "value": "50",
                  "unit": "%"
                }
              }
            }
          }
        }
      },
      {
        "when": "tank_2 reads 80.5 % +/- 2: the comparison with 80 % is unknown, so the run fails (S261)",
