{
  "id": "k06_tank_close_to_the_mark",
  "prompt": "With crawler2, drive to tank_farm and read how full tank_2 is with cam_crawler2. If it is more than 80 percent full, tell channel \"maintenance\" \"tank_2 is nearly full\"; if it is not, tell no one.",
  "world": "bench/worlds/plant_room.json",
  "group": "kind",
  "expect": {
    "decision": "cannot",
    "category": "inexpressible"
  },
  "expect_2_2": {
