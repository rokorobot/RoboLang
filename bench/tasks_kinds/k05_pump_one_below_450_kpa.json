          ]
        ],
        "world_patch": {
          "objects": {
            "gauge_p1": {
              "properties": {
                "pressure": {
                  "value": "4.2",
                  "unit": "bar"
                }
              }
            }
          }
        }
      },
      {
        "when": "gauge_p1 reads 5.5 bar = 550 kPa: not below 450 kPa",
        "goal": [
          [
            "rl:robot:crawler2",
            "located_in",
            "rl:place:pump_1"
          ]
        ],
        "messages": [],
        "world_patch": {
          "objects": {
            "gauge_p1": {
              "properties": {
                "pressure": {
                  "value": "5.5",
                  "unit": "bar"
                }
              }
            }
          }
        }
      }
    ]
  },
  "gap": "G-PERCEIVE",
  "tags": [
    "pressure",
    "kpa",
    "bar",
    "conversion",
    "if"
