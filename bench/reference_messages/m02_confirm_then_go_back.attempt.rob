// bench/reference_messages/m02_confirm_then_go_back.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.0;

task deliver_and_return(robot r, object med, location src, location room, location base) {
    goal { object_at med room; robot_at r base; }
    plan {
        move r to src;
        grasp r med;
        move r to room;
        place r med at room;
        wait until message_received "nurse" with "CONFIRMED" timeout 15 min else {  // @message
            communicate r to "alerts" with "no confirmation";                       // @message
            fail "the nurse did not confirm";                                       // @message
        }                                                                           // @message
        move r to base;
    }
}
