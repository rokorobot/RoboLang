// bench/reference_messages/m04_rounds_until_shift_end.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.0;

task round(robot r, location home, location far) {
    goal { robot_at r home; }
    plan {
        move r to far;
        wait for 20 s;
        move r to home;
    }
}

mission rounds(robot r, location home, location far) {
    repeat at most 12 runs {
        run round(r, home, far);
    } until message_received "ops" with "SHIFT END";  // @message-tail
    on failure { stop; }
}
