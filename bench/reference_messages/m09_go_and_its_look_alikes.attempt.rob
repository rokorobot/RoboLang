// bench/reference_messages/m09_go_and_its_look_alikes.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.0;

task take_tray(robot r, object tray, location src, location dst) {
    goal { object_at tray dst; }
    plan {
        move r to src;
        grasp r tray;
        wait until message_received "pharmacy_west" with "GO" timeout 10 min else { fail "no go"; }  // @message
        move r to dst;
        place r tray at dst;
    }
}
