// bench/reference_messages/m07_lobby_when_it_opens.rob: hand-written reference (RoboLang 2.1)
robolang 2.1;

task clean_to_lobby(robot r, location lobby, region wet) {
    @safety no_go_region wet;
    goal { robot_at r lobby; }
    plan {
        wait until message_received "facility" with "LOBBY OPEN" timeout 10 min else { fail "the lobby did not open"; }
        move r to lobby;
    }
}
