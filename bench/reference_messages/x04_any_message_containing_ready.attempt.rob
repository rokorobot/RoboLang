// bench/reference_messages/x04_any_message_containing_ready.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.0;

task hand_to_line(robot r, object tote, location src, location hold, location dst) {
    goal { object_at tote dst; }
    plan {
        move r to src;
        grasp r tote;
        move r to hold;
        wait until message_received "line" containing "READY" timeout 10 min else { fail "no ready message"; }  // @message
        move r to dst;
        place r tote at dst;
    }
}
