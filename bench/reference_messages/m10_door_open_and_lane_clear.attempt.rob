// bench/reference_messages/m10_door_open_and_lane_clear.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.0;

task unload_case(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        wait until message_received "dock" with "DOOR OPEN" timeout 10 min else { fail "the dock door did not open"; }  // @message
        wait until message_received "safety" with "LANE CLEAR" timeout 10 min else { fail "the lane was not cleared"; }  // @message
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}
