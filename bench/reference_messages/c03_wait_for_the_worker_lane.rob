// bench/reference_messages/c03_wait_for_the_worker_lane.rob: hand-written reference
robolang 2.0;

task carry_tote(robot r, object item, location src, location dst, region lane) {
    goal { object_at item dst; }
    plan {
        wait until region_clear lane timeout 30 s else { fail "the worker lane did not clear"; }
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
    }
}
