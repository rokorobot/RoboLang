// bench/reference_self/c01_how_full_is_the_bin.rob: hand-written reference (RoboLang 2.4)
robolang 2.4;

task check_bin(robot r, object bin, sensor cam, location bay) {
    goal { robot_at r bay; }
    plan {
        move r to bay;
        measure r fill of bin using cam as f;
        if f < 30 % {
            communicate r to "lead" with "restock bin_1";
        }
    }
}
