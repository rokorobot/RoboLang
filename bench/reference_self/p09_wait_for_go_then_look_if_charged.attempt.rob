// bench/reference_self/p09_wait_for_go_then_look_if_charged.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.3;

task wait_then_look(robot r, object bin, sensor cam, location home) {
    goal { robot_at r home; }
    plan {
        wait until message_received "ops" with "GO" timeout 15 min else { fail "no GO"; }
        measure r charge as c;                                                                      // @charge
        if c < 40 % {                                                                               // @charge
            communicate r to "lead" with "battery low";                                             // @charge
            fail "battery too low";                                                                 // @charge
        }                                                                                           // @charge
        measure r fill of bin using cam as f;
        if f > 70 % {
            communicate r to "lead" with "empty bin_1";
        }
    }
}
