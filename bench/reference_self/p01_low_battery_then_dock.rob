// bench/reference_self/p01_low_battery_then_dock.rob: hand-written reference (RoboLang 2.4)
robolang 2.4;

task dock_or_go_on(robot r, location dock, location next) {
    plan {
        measure r charge as c;
        if c < 25 % {
            goal { robot_at r dock; }
            move r to dock;
            communicate r to "lead" with "spot1 is docked";
        } else {
            goal { robot_at r next; }
            move r to next;
        }
    }
}
