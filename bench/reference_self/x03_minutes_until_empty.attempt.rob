// bench/reference_self/x03_minutes_until_empty.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 2.3;

task report_minutes(robot r, location d) {
    goal { robot_at r d; }
    plan {
        move r to d;
        measure r charge as c;                                                                      // @charge
        communicate r to "lead" with c;                                                             // @charge
    }
}
