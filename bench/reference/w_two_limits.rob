// bench/reference/w_two_limits.rob: hand-written reference solution
robolang 1.3;

task limited_move(robot r, object box, location src, location dst) {
    @safety max_speed 0.8 m/s;
    @safety max_speed 1 rad/s;
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
