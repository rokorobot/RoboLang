// bench/reference/l_vial_to_fridge.rob: hand-written reference solution
robolang 1.3;

task store_vial(robot r, object vial, location src, location dst) {
    goal { object_at vial dst; }
    plan {
        move r to src;
        grasp r vial;
        move r to dst;
        place r vial at dst;
    }
}
