// bench/reference/a_arm_handover.rob: hand-written reference solution
robolang 1.3;

task arm_handover(robot a, robot b, object part, location feed, location mid, location dst, region fence) {
    goal { object_at part dst; }
    plan {
        move a to feed;
        grasp a part;
        move a to mid;
        place a part at mid;
        wait until region_clear fence timeout 30s;
        move b to mid;
        grasp b part;
        move b to dst;
        place b part at dst;
    }
}
