// bench/reference/w_two_boxes.rob: hand-written reference solution
robolang 1.3;

task bring_both(robot r, object a, object b, location sa, location sb, location dst) {
    goal {
        object_at a dst;
        object_at b dst;
    }
    plan {
        move r to sa;
        grasp r a;
        move r to dst;
        place r a at dst;
        move r to sb;
        grasp r b;
        move r to dst;
        place r b at dst;
    }
}
