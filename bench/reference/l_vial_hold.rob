// bench/reference/l_vial_hold.rob: hand-written reference solution
robolang 1.3;

task centrifuge_then_carry(robot r, object a, object b, location bench, location spin, location fridge) {
    goal {
        object_at a spin;
        holding r b;
        robot_at r bench;
    }
    plan {
        move r to bench;
        grasp r a;
        move r to spin;
        place r a at spin;
        move r to fridge;
        grasp r b;
        move r to bench;
    }
}
