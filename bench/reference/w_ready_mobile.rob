// bench/reference/w_ready_mobile.rob: hand-written reference solution
robolang 1.3;

task ferry_crate(robot r, object crate, location dock, location dst) {
    pre { robot_ready r; }
    goal { object_at crate dst; }
    plan {
        move r to dock;
        grasp r crate;
        move r to dst;
        place r crate at dst;
    }
}
