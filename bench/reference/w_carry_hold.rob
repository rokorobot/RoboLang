// bench/reference/w_carry_hold.rob: hand-written reference solution
robolang 1.3;

task carry_crate(robot r, object crate, location dock, location dst) {
    goal {
        holding r crate;
        robot_at r dst;
    }
    plan {
        move r to dock;
        grasp r crate;
        move r to dst;
    }
}
