// bench/reference/e_pre_and.rob: hand-written reference solution
robolang 1.3;

task checked_move(robot r, object box, location src, location dst, region cell) {
    pre { robot_ready r and region_clear cell; }
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
