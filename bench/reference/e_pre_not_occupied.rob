// bench/reference/e_pre_not_occupied.rob: hand-written reference solution
robolang 1.3;

task move_while_busy(robot r, object box, location src, location dst, region zone) {
    pre { not region_clear zone; }
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
