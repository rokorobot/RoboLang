// bench/reference/e_speed_half.rob: hand-written reference solution
robolang 1.3;

task careful_move(robot r, object box, location src, location dst) {
    @safety max_speed 0.5 m/s;
    goal { object_at box dst; }
    plan {
        move r to src;
        grasp r box;
        move r to dst;
        place r box at dst;
    }
}
