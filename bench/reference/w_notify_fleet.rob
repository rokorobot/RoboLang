// bench/reference/w_notify_fleet.rob: hand-written reference solution
robolang 1.3;

task move_and_notify(robot r, object item, location src, location dst) {
    goal { object_at item dst; }
    plan {
        move r to src;
        grasp r item;
        move r to dst;
        place r item at dst;
        communicate r to "fleet" with "PART_MOVED";
    }
}
