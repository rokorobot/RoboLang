{
  "id": "b_plate_or_report",
  "prompt": "If plate1 is in storage, have arm1 bring it to the bench. If it is not, send \"plate1 not in storage\" to channel \"lab\" from arm1 and stop the job as failed.",
  "world": "bench/worlds/lab.json",
  "group": "branching",
  "expect": {
    "decision": "program"
  },
  "expect_1_3": {
    "decision": "cannot",
    "category": "inexpressible"
  },
  "expect_1_4": {
    "decision": "program",
    "paths": [
      {
        "when": "object_at plate1 storage",
        "goal": [
          [
            "rl:thing:plate1",
            "located_in",
            "rl:place:bench"
          ]
        ],
        "world_patch": {
          "events": [],
          "objects": {
            "plate1": {
              "location": "storage"
            }
          }
        }
      },
      {
        "when": "not object_at plate1 storage",
        "fail": "plate1 not in storage",
        "messages": [
          [
            "lab",
            "plate1 not in storage"
          ]
        ],
        "world_patch": {
          "events": [],
          "objects": {
            "plate1": {
              "location": "bench"
            }
          }
        }
      }
    ]
  },
  "tags": [
    "branching",
    "report_and_stop",
    "object"
  ],
  "why": "The request needs a choice made at run time from the state of the world. RoboLang 1.3 has no if/else: `pre` only stops a run, and a goal states one fixed end state. RoboLang 1.4 (decision 0027) expresses it with `if`.",
  "attempt_fails_with": "E203"
}
