{
  "id": "b_aisle_or_report",
  "prompt": "Have amr1 carry crate1 from the dock to the handoff if the aisle is clear when the job starts. If it is not, keep amr1 at the dock, send \"aisle blocked\" to channel \"ops\" from amr1 and stop the job as failed.",
  "world": "bench/worlds/warehouse.json",
  "group": "branching",
  "expect": {
    "decision": "program"
  },
  "expect_1_3": {
    "decision": "cannot",
    "category": "inexpressible"
  },
  "expect_1_4": {
    "decision": "program",
    "paths": [
      {
        "when": "region_clear aisle",
        "goal": [
          [
            "rl:thing:crate1",
            "located_in",
            "rl:place:handoff"
          ]
        ],
        "world_patch": {
          "events": [],
          "regions": {
            "aisle": {
              "clear": true
            }
          }
        }
      },
      {
        "when": "not region_clear aisle",
        "fail": "aisle blocked",
        "messages": [
          [
            "ops",
            "aisle blocked"
          ]
        ],
        "world_patch": {
          "events": [],
          "regions": {
            "aisle": {
              "clear": false
            }
          }
        }
      }
    ]
  },
  "tags": [
    "branching",
    "report_and_stop",
    "region"
  ],
  "why": "The request needs a choice made at run time from the state of the world. RoboLang 1.3 has no if/else: `pre` only stops a run, and a goal states one fixed end state. RoboLang 1.4 (decision 0027) expresses it with `if`.",
  "attempt_fails_with": "E203"
}
