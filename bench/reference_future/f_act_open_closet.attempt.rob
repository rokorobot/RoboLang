// bench/reference_future/f_act_open_closet.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task fetch_kit(robot r, object kit, object door, location closet, location ward) {
    goal { object_at kit ward; }
    plan {
        move r to closet;
        open r door;
        grasp r kit;
        move r to ward;
        place r kit at ward;
        communicate r to "charge_nurse" with "the IV kit is in ward 3";
    }
}
