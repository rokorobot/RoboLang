// bench/reference_future/f_act_open_closet.rob: hand-written reference
robolang 1.8;

task open_and_deliver(robot r, object door, object kit, location closet, location dst) {
    goal { in_state door "open"; object_at kit dst; }
    plan {
        move r to closet;
        do r open door;
        grasp r kit;
        move r to dst;
        place r kit at dst;
        communicate r to "charge_nurse" with "the kit is in ward_3";
    }
}
