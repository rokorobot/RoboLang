// bench/reference_future/f_clock_shift_cutoff.rob: hand-written reference
robolang 1.9;

task move_tote(robot r, object tote, location src, location dst) {
    plan {
        measure r time as now;
        if now < 22:00 {
            goal { object_at tote dst; }
            move r to src;
            grasp r tote;
            move r to dst;
            place r tote at dst;
        } else {
            goal { object_at tote src; }
            communicate r to "lead" with "the shift is over";
        }
    }
}
