// bench/reference_future/f_choose_nearest_dock.rob: hand-written reference (RoboLang 2.3)
robolang 2.3;

task nearest_dock(robot r, location d1, location d2, location d3) {
    goal { robot_at r dock; }
    plan {
        choose location dock from (d1, d2, d3) nearest to r else { fail "no dock"; }
        move r to dock;
    }
}
