// bench/reference_future/f_clock_scan_stamp.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task scan(robot r, object box, location shelf, sensor camera) {
    goal { robot_at r shelf; }
    plan {
        move r to shelf;
        inspect r box using camera;
        communicate r to "lead" with time_now;
    }
}
