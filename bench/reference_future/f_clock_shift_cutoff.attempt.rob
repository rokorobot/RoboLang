// bench/reference_future/f_clock_shift_cutoff.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task move_tote(robot r, object tote, location src, location dst) {
    plan {
        if time_of_day < 22:00 {
            goal { object_at tote dst; }
            move r to src;
            grasp r tote;
            move r to dst;
            place r tote at dst;
        } else {
            communicate r to "lead" with "the shift is over";
            fail "shift over";
        }
    }
}
