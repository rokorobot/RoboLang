// bench/reference_future/f_act_set_fryer.attempt.rob: the obvious attempt; it does not do what the request asks
robolang 1.6;

task start_batch(robot r, object basket, object oil, sensor probe, location src, location fryer) {
    goal { object_at basket fryer; }
    plan {
        set_temperature r fryer 175 degC;
        move r to fryer;
        wait until temperature of oil using probe >= 175 degC timeout 10 min else { fail "oil too cold"; }
        move r to src;
        grasp r basket;
        move r to fryer;
        place r basket at fryer;
    }
}
